{
  "name": "@aegis/api",
  "version": "0.0.0",
  "private": true,
  "description": "Aegis API — Fastify backend",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts"
  },
  "dependencies": {
    "@aegis/contracts": "^0.0.0",
    "@aegis/domain": "^0.0.0",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
