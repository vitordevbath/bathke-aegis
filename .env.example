# Copy to .env and fill in locally. Never commit .env.
API_PORT=3000
API_HOST=0.0.0.0
DATABASE_URL=mysql://aegis:change-me@mysql:3306/aegis
MYSQL_DATABASE=aegis
MYSQL_USER=aegis
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Placeholder is rejected at startup. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
JWT_TTL_SECONDS=3600
AUTH_RATE_LIMIT_MAX=10
# Event ingestion batches per IP per minute (machine credentials).
INGEST_RATE_LIMIT_MAX=60
# Requests per IP per minute on the machine pairing endpoint.
PAIR_RATE_LIMIT_MAX=10
# Refused pairing codes per IP per window before that IP is paused (temporary).
PAIR_INVALID_ATTEMPTS_MAX=20
PAIR_INVALID_ATTEMPTS_WINDOW_SECONDS=900
# Pairing codes an OWNER may request for one host per hour.
PAIR_CODES_PER_HOST_PER_HOUR=10
# Host port published by nginx (optional, default 8080).
AEGIS_HTTP_PORT=8080
