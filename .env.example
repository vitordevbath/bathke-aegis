# Copy to .env and fill in locally. Never commit .env.
API_PORT=3000
API_HOST=0.0.0.0
DATABASE_URL=mysql://aegis:change-me@mysql:3306/aegis
MYSQL_DATABASE=aegis
MYSQL_USER=aegis
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# Placeholder is rejected at startup. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
JWT_TTL_SECONDS=3600
AUTH_RATE_LIMIT_MAX=10
# Host port published by nginx (optional, default 8080).
AEGIS_HTTP_PORT=8080
